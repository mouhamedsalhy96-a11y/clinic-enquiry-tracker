# Supabase connection values will be added in the persistent-core milestone.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never add NEXT_PUBLIC_ or commit its value.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile: site key is public; secret stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Deployment only: exact HTTPS origin, no path. Leave empty locally.
APP_ORIGIN=
# Explicit release switch; Turnstile and database validation still apply.
PUBLIC_SUBMISSIONS_ENABLED=false
